# ============================================================================
# Environment Variables for Multi-Agent POC
# Copy to .env and fill in your values
# ============================================================================

# Required: Anthropic API key (for Claude Sonnet - Survey & Architect agents)
ANTHROPIC_API_KEY=sk-ant-...

# Required: Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional: Tavily API key (for web search in Architect agent)
# TAVILY_API_KEY=tvly-...

# Optional: LangSmith tracing (for debugging agent execution)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=deer-flow-poc
